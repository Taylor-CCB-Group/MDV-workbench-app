{
  "name": "mdv",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "shutdownAction": "none",
  "workspaceFolder": "/workspace",
  // Workbench copies its startupscript/ directory into this repository before launch.
  // The scripts run as root through remoteUser, then act as pn with `sudo -u pn`.
  "postCreateCommand": [
    "./startupscript/post-startup.sh",
    "pn",
    "/home/pn",
    "${templateOption:cloud}",
    "${templateOption:login}"
  ],
  "postStartCommand": [
    "./startupscript/remount-on-restart.sh",
    "pn",
    "/home/pn",
    "${templateOption:cloud}",
    "${templateOption:login}"
  ],
  // The Workbench CLI that post-startup.sh installs needs Java, and install-java.sh only
  // links an existing one.
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    },
    "ghcr.io/joshuanianji/devcontainer-features/google-cloud-cli:1": {}
  },
  "remoteUser": "root",
  "customizations": {
    "workbench": {
      "proxyTargetPort": 5055
    }
  }
}
